# Copy to .env. There are no credentials in here: every password lives in Vault and is
# generated by vault-bootstrap on the first start (see README -> Secrets with Vault).

# Database identity, used to seed the Vault secret on the very first start.
# After that Vault is the source of truth and changing these has no effect.
DB_USER=nullops
DB_NAME=nullops_db

# Gunicorn worker processes per app container
APP_WORKERS=2

# Host ports
NGINX_PORT=80
CADVISOR_PORT=8081
VAULT_PORT=8200
